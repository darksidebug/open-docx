# Copy this file to .env (or .env.local) and adjust to match your Laravel app.

# Base URL of your Laravel API.
LARAVEL_API_URL=http://localhost:8000

# Laravel routes this app calls. Defaults assume a Sanctum-style API:
#   POST {LARAVEL_LOGIN_PATH}    body: { email, password }       -> { token, user }
#   GET  {LARAVEL_USER_PATH}     header: Authorization: Bearer   -> user
#   POST {LARAVEL_LOGOUT_PATH}   header: Authorization: Bearer
#   POST {LARAVEL_REGISTER_PATH} body: dummy user fields          (used only by `npm run dummy-user`)
# Adjust these if your actual routes differ.
LARAVEL_LOGIN_PATH=/api/login
LARAVEL_USER_PATH=/api/user
LARAVEL_LOGOUT_PATH=/api/logout
LARAVEL_REGISTER_PATH=/api/register

# The user object returned by Laravel is expected to look like:
#   { id, email, first_name, middle_name, last_name, suffix, email_verified_at, ... }

# Per-document routes (documents are service templates identified by a UUID,
# each tied to an ordered service). `:id` is replaced with the document's UUID.
#   GET {LARAVEL_DOCUMENT_PATH}  header: Authorization: Bearer
#     -> 200 + { document } if this user is assigned to the document's ordered
#        service (eligible to open/edit it); 403/404 otherwise.
#   PUT {LARAVEL_REPORT_PATH}    header: Authorization: Bearer
#     body: { content: <Tiptap JSON>, html: <string>, updated_at }
#     Expected to write to a separate "final reporting" table, not the
#     document/template table itself.
LARAVEL_DOCUMENT_PATH=/api/documents/:id
LARAVEL_REPORT_PATH=/api/documents/:id/report

# Real-time collaboration (Yjs/Hocuspocus) server.
COLLAB_WS_PORT=1234
NEXT_PUBLIC_COLLAB_WS_URL=ws://localhost:1234

# Auto-save to the reporting table is debounced, not fired on every keystroke:
# it saves this long after the last edit (ms), but at least this often while
# someone keeps typing continuously (ms).
COLLAB_SAVE_DEBOUNCE_MS=4000
COLLAB_SAVE_MAX_DEBOUNCE_MS=20000

# Dummy/test account used by `npm run dummy-user` to register a test user via
# the Laravel API. Also mirrored as NEXT_PUBLIC_* so the login page can show a
# "use dummy account" shortcut button.
DUMMY_USER_EMAIL=dummy.tester@example.com
DUMMY_USER_FIRST_NAME=Dummy
DUMMY_USER_MIDDLE_NAME=
DUMMY_USER_LAST_NAME=Tester
DUMMY_USER_SUFFIX=
DUMMY_USER_PASSWORD=Password123!
NEXT_PUBLIC_DUMMY_USER_EMAIL=dummy.tester@example.com
NEXT_PUBLIC_DUMMY_USER_PASSWORD=Password123!
