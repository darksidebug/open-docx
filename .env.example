# Copy this file to .env (or .env.local) and adjust to match your Laravel app.

# Signs the session cookie (which holds the logged-in user + their Laravel
# token, captured at login — see lib/auth/session.ts). Required; the app
# throws on startup without it. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=

# Base URL of your Laravel API.
# - Local dev (both apps running directly on your machine, no Docker): http://localhost:8000
# - Running THIS app via docker-compose against a separately-dockerized
#   Laravel: 127.0.0.1/localhost here means "this container", not your host
#   or Laravel's container. Use http://host.docker.internal:<host-published-port>
#   instead — Docker's built-in DNS name for "the host machine" from inside any
#   container, e.g. http://host.docker.internal:8000 if Laravel's nginx is
#   published to the host as 8000 (same port you'd use in a browser on that
#   machine). See the `extra_hosts` entry in docker-compose.yml.
LARAVEL_API_URL=http://host.docker.internal:8000/v1

# Laravel routes this app calls.
#   POST {LARAVEL_LOGIN_PATH}    body: { email, password }
#     -> { status: "success", user: {...}, authorization: { token } }
#     (confirmed against this API — see main-app.md's useAuth.ts). The app
#     stores this token + user in its own signed session cookie at login —
#     there's no separate "get current user" endpoint call on every request,
#     since none is confirmed to exist for this API.
#   POST {LARAVEL_LOGOUT_PATH}   header: Authorization: Bearer
#   POST {LARAVEL_REGISTER_PATH} body: dummy user fields          (used only by `npm run dummy-user`)
# LOGOUT_PATH/REGISTER_PATH below follow the same /v1/auth/* convention as the
# confirmed login route, but aren't independently verified yet — adjust if
# your actual routes differ.
LARAVEL_LOGIN_PATH=/auth/login
LARAVEL_LOGOUT_PATH=/auth/logout
LARAVEL_REGISTER_PATH=/auth/register

# The user object returned by Laravel is expected to look like:
#   { id, email, first_name, middle_name, last_name, suffix, email_verified_at, ... }

# Per-document routes (documents are service templates identified by a UUID,
# each tied to an ordered service). `:id` is replaced with the document's UUID.
#   GET {LARAVEL_DOCUMENT_PATH}  header: Authorization: Bearer
#     -> 200 + { document } if this user is assigned to the document's ordered
#        service (eligible to open/edit it); 403/404 otherwise.
#   PUT {LARAVEL_REPORT_PATH}    header: Authorization: Bearer
#     body: { content: <Tiptap JSON>, html: <string>, updated_at }
#     Expected to write to a separate "final reporting" table, not the
#     document/template table itself.
#   GET {LARAVEL_REPORT_PATH}    header: Authorization: Bearer
#     -> 200 + { content, html, updated_at } (the same shape PUT sends), or
#        404 if the document has never been saved yet. Used to render the
#        read-only /docs/[id]/view page without a live collaboration session.
# Not yet confirmed against your real API (unlike the login route above) —
# these are hypothetical routes this feature was designed against. Adjust the
# paths (and the `` prefix, to match your API's actual versioning) once
# you've built/located the real ones on the Laravel side.
LARAVEL_DOCUMENT_PATH=/documents/:id
LARAVEL_REPORT_PATH=/documents/:id/report

# Docs dashboard (/docs): "Recent documents" list and "Start a new document"
# template gallery + creation. See README's "Docs dashboard" section for the
# exact request/response shapes expected. Also not yet confirmed.
LARAVEL_DOCUMENTS_LIST_PATH=/documents
LARAVEL_TEMPLATES_LIST_PATH=/service-templates

# Real-time collaboration (Yjs/Hocuspocus) server.
COLLAB_WS_PORT=1234
NEXT_PUBLIC_COLLAB_WS_URL=ws://localhost:1234

# Auto-save to the reporting table is debounced, not fired on every keystroke:
# it saves this long after the last edit (ms), but at least this often while
# someone keeps typing continuously (ms).
COLLAB_SAVE_DEBOUNCE_MS=4000
COLLAB_SAVE_MAX_DEBOUNCE_MS=20000

# Dummy/test account used by `npm run dummy-user` to register a test user via
# the Laravel API. Also mirrored as NEXT_PUBLIC_* so the login page can show a
# "use dummy account" shortcut button.
DUMMY_USER_EMAIL=dummy.tester@example.com
DUMMY_USER_FIRST_NAME=Dummy
DUMMY_USER_MIDDLE_NAME=
DUMMY_USER_LAST_NAME=Tester
DUMMY_USER_SUFFIX=
DUMMY_USER_PASSWORD=Password123!
NEXT_PUBLIC_DUMMY_USER_EMAIL=dummy.tester@example.com
NEXT_PUBLIC_DUMMY_USER_PASSWORD=Password123!
